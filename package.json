{
  "name": "shadcn-rte",
  "version": "1.0.2",
  "description": "A rich text editor and viewer for React, built with shadcn/ui, Radix UI, and Tailwind CSS.",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "rich-text-editor",
    "wysiwyg",
    "react",
    "tailwindcss",
    "contenteditable"
  ],
  "license": "MIT",
  "author": "jsdev-robin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdev-robin/shadcn-rte.git"
  },
  "bugs": {
    "url": "https://github.com/jsdev-robin/shadcn-rte/issues"
  },
  "homepage": "https://github.com/jsdev-robin/shadcn-rte#readme",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
