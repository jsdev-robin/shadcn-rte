{
  "name": "shadcn-rte",
  "version": "1.0.0",
  "description": "A rich text editor and viewer for React, built with shadcn/ui, Radix UI, and Tailwind CSS.",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "rich-text-editor",
    "wysiwyg",
    "react",
    "tailwindcss",
    "contenteditable"
  ],
  "license": "MIT",
  "author": "jsdev-robin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdev-robin/shadcn-rte.git"
  },
  "bugs": {
    "url": "https://github.com/jsdev-robin/shadcn-rte/issues"
  },
  "homepage": "https://github.com/jsdev-robin/shadcn-rte#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "radix-ui": {
      "optional": false
    },
    "lucide-react": {
      "optional": false
    },
    "class-variance-authority": {
      "optional": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^4.5.4"
  }
}
